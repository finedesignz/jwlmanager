{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JWL Manager",
  "version": "0.1.0",
  "identifier": "com.titaniumlabs.jwlmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JWL Manager",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../libs/jwlCore-amd64.dll": "libs/jwlCore-amd64.dll",
      "../../libs/libjwlCore-x86_64.so": "libs/libjwlCore-x86_64.so",
      "../../libs/libjwlCore-arm64.so": "libs/libjwlCore-arm64.so",
      "../../libs/libjwlCore.dylib": "libs/libjwlCore.dylib",
      "../../libs/sqlite3_64.dll": "libs/sqlite3_64.dll",
      "../../res/resources.db": "res/resources.db"
    }
  }
}
